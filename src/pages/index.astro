---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_DESCRIPTION, withBase } from '../consts';

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Readers arrive with one of two questions: what does this cost, or am I
// allowed to do this. Reverse-chronological answers neither, so the list is
// split on that instead of on date. Licensing wins when a piece carries both
// tags, because that is always the harder half to find elsewhere.
const isLicensing = (a: any) => a.data.tags.includes('licensing');
const costs = all.filter((a) => !isLicensing(a));
const rights = all.filter(isLicensing);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

// The freshest check date on the site. It is the one number that says most
// about whether any of this is still true.
const checked = all.map((a) => a.data.pricesCheckedOn).filter(Boolean) as Date[];
const lastChecked = checked.length
  ? new Date(Math.max(...checked.map((d) => d.valueOf())))
  : null;

const home = new URL(withBase('/'), Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: SITE_NAME, description: SITE_DESCRIPTION, url: home },
    {
      '@type': 'ItemList',
      name: 'Articles',
      itemListElement: all.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(withBase(`/articles/${a.id}/`), Astro.site).href,
        name: a.data.title,
      })),
    },
  ],
};
---
<BaseLayout title={SITE_NAME} schema={schema}>
  <div class="page-head">
    <h1>Audio tools, without the guesswork</h1>
    <p class="lede">
      I look at what music and audio software costs, what the small print allows, and which
      option makes sense for the job. Prices come with a check date and a link to the source.
    </p>
  </div>

  <div class="section-head">
    <h2>Choosing and paying for tools</h2>
    {lastChecked && <span class="meta">Last checked {fmt(lastChecked)}</span>}
  </div>
  <ul class="list">
    {costs.map((a) => (
      <li>
        <h2><a href={withBase(`/articles/${a.id}/`)}>{a.data.title}</a></h2>
        <p>{a.data.description}</p>
        <p class="meta">
          <span>{fmt(a.data.pubDate)}</span>
          {a.data.pricesCheckedOn && <span>Prices checked {fmt(a.data.pricesCheckedOn)}</span>}
        </p>
      </li>
    ))}
  </ul>

  <div class="section-head">
    <h2>Terms, rights and releasing music</h2>
    <span class="meta">Read from the terms</span>
  </div>
  <ul class="list">
    {rights.map((a) => (
      <li>
        <h2><a href={withBase(`/articles/${a.id}/`)}>{a.data.title}</a></h2>
        <p>{a.data.description}</p>
        <p class="meta">
          <span>{fmt(a.data.pubDate)}</span>
          {a.data.pricesCheckedOn && <span>Prices checked {fmt(a.data.pricesCheckedOn)}</span>}
        </p>
      </li>
    ))}
  </ul>

  <div class="section-head"><h2>How I work</h2></div>
  <p>
    I go to the source first: the pricing page, terms, help centre or official documentation.
    I link the pages I used and date the check so you can see how fresh the information is.
  </p>
  <p>
    I don't publish hands-on sound comparisons. When sound quality matters, I name the source
    of the comparison; when I can't verify a price or a claim, I leave it out or say so.
  </p>
  <p class="meta">
    If a link earns a commission, I'll label it on the page. It won't change the prices or terms
    quoted here.
  </p>
</BaseLayout>
