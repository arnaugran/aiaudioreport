---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE_NAME, SITE_DESCRIPTION, withBase } from '../consts';

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const isLicensing = (article: (typeof all)[number]) => article.data.tags.includes('licensing');
const sections = [
  {
    id: 'prices',
    name: 'Prices and plans',
    blurb: 'What each plan costs, what you get, and the limits that are easy to miss.',
    items: all.filter((article) => !isLicensing(article)),
  },
  {
    id: 'rights',
    name: 'Rights and releases',
    blurb: 'What the terms say about samples, AI music, voice models and distribution.',
    items: all.filter(isLicensing),
  },
];

const fmt = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const checked = all.map((article) => article.data.pricesCheckedOn).filter(Boolean) as Date[];
const lastChecked = checked.length
  ? new Date(Math.max(...checked.map((date) => date.valueOf())))
  : null;

const home = new URL(withBase('/'), Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: SITE_NAME, description: SITE_DESCRIPTION, url: home },
    {
      '@type': 'ItemList',
      name: 'Articles',
      itemListElement: all.map((article, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(withBase(`/articles/${article.id}/`), Astro.site).href,
        name: article.data.title,
      })),
    },
  ],
};
---
<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION} schema={schema}>
  <header class="home-intro">
    <h1>Before you buy a music tool</h1>
    <p>
      I check what audio software costs, what its licence allows, and what the plan leaves out.
      Each guide links to the original sources and shows when I checked them.
    </p>
    <a class="home-browse" href={withBase('/articles/')}>Search the article index <span aria-hidden="true">→</span></a>
    {lastChecked && <p class="home-checked">Most recent price check: {fmt(lastChecked)}</p>}
  </header>

  {sections.map((section) => (
    <section class="home-section" id={section.id}>
      <div class="home-section-head">
        <h2>{section.name}</h2>
        <span>{section.items.length} {section.items.length === 1 ? 'guide' : 'guides'}</span>
      </div>
      <p class="home-section-blurb">{section.blurb}</p>
      <ul class="home-guides">
        {section.items.map((article) => (
          <li>
            <a href={withBase(`/articles/${article.id}/`)}>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
            </a>
            <p class="home-guide-date">
              {article.data.pricesCheckedOn
                ? `Prices checked ${fmt(article.data.pricesCheckedOn)}`
                : `${article.data.updatedDate ? 'Updated' : 'Published'} ${fmt(article.data.updatedDate ?? article.data.pubDate)}`}
            </p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="home-about">
    <h2>About these guides</h2>
    <p>
      I read the vendor's pricing pages, documentation and terms. I don't run listening tests;
      when sound quality matters, I link to people who have tested the tools themselves.
    </p>
  </section>

  <Newsletter variant="inline" />
</BaseLayout>
