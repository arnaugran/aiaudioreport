---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE_NAME, SITE_DESCRIPTION, withBase } from '../consts';
import { headerPhoto } from '../lib/photos.mjs';

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Readers arrive with one of two questions: what does this cost, or am I
// allowed to do this. Reverse-chronological answers neither, so the list is
// split on that instead of on date. Licensing wins when a piece carries both
// tags, because that is always the harder half to find elsewhere.
const isLicensing = (a: any) => a.data.tags.includes('licensing');

// The newest piece leads the page on its own. Pulling it out of the grid below
// stops it appearing twice, which reads as a bug rather than as emphasis.
const [featured, ...rest] = all;

const sections = [
  {
    id: 'costs',
    chip: 'Cost',
    tone: 'a',
    name: 'What it costs',
    blurb: 'Plans, export limits, credits and what they add to the monthly cost.',
    items: rest.filter((a) => !isLicensing(a)),
  },
  {
    id: 'rights',
    chip: 'Rights',
    tone: 'b',
    name: 'Rights and releases',
    blurb: 'What the terms say about samples, AI music, voices and distribution.',
    items: rest.filter(isLicensing),
  },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

// The freshest check date on the site. It is the one number that says most
// about whether any of this is still true.
const checked = all.map((a) => a.data.pricesCheckedOn).filter(Boolean) as Date[];
const lastChecked = checked.length
  ? new Date(Math.max(...checked.map((d) => d.valueOf())))
  : null;

// Card art reuses each article's own header photograph, so the picture a reader
// clicks is the picture at the top of the page they land on.
const pic = (a: any, ext: string, w: number) =>
  withBase(`/img/${headerPhoto(a.id, a.data.tags)}-${w}.${ext}`);

const home = new URL(withBase('/'), Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: SITE_NAME, description: SITE_DESCRIPTION, url: home },
    {
      '@type': 'ItemList',
      name: 'Articles',
      itemListElement: all.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(withBase(`/articles/${a.id}/`), Astro.site).href,
        name: a.data.title,
      })),
    },
  ],
};
---
<BaseLayout title={SITE_NAME} schema={schema}>
  <section class="bleed hero">
    <p class="hero-kicker">By Arnau Gran i Romero</p>
    <h1>Before you buy a music tool</h1>
    <p class="hero-lede">
      I check what audio software costs, what its licence allows and which limits matter before
      you pay. I link to the sources and include the date I checked each price.
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={withBase('/articles/')}>Browse all {all.length} articles</a>
      <a class="btn btn-ghost" href="#method">How I work</a>
    </div>
    <ul class="hero-stats">
      <li><strong>{all.length}</strong><span>guides on audio tools</span></li>
      {lastChecked && <li><strong>{fmt(lastChecked)}</strong><span>most recent price check</span></li>}
      <li><strong>No</strong><span>affiliate links or paid recommendations</span></li>
    </ul>
    <svg class="hero-wave" viewBox="0 0 320 90" aria-hidden="true" focusable="false">
      {Array.from({ length: 40 }, (_, i) => {
        const h = 10 + ((i * 37) % 31) + ((i % 5) * 7);
        return <rect x={i * 8} y={90 - h} width="4" height={h} rx="2" />;
      })}
    </svg>
  </section>

  <a class="bleed feat" href={withBase(`/articles/${featured.id}/`)}>
    <picture>
      <source type="image/avif" srcset={pic(featured, 'avif', 800)} />
      <img src={pic(featured, 'webp', 800)} alt="" width="800" height="267" decoding="async" />
    </picture>
    <div class="feat-txt">
      <span class="chip chip-a">Latest</span>
      <h2>{featured.data.title}</h2>
      <p>{featured.data.description}</p>
      <p class="feat-meta">
        <span>{fmt(featured.data.pubDate)}</span>
        {featured.data.pricesCheckedOn && <span>Prices checked {fmt(featured.data.pricesCheckedOn)}</span>}
      </p>
    </div>
  </a>

  {sections.map((s) => (
    <div class="bleed">
      <div class="sec-head">
        <h2>{s.name}</h2>
        <span class="meta">{s.items.length} {s.items.length === 1 ? 'piece' : 'pieces'}</span>
      </div>
      <p class="sec-blurb">{s.blurb}</p>
      <ul class="cards">
        {s.items.map((a) => (
          <li class="card">
            <a href={withBase(`/articles/${a.id}/`)}>
              <picture>
                <source type="image/avif" srcset={pic(a, 'avif', 800)} />
                <img src={pic(a, 'webp', 800)} alt="" width="800" height="450"
                     loading="lazy" decoding="async" />
              </picture>
              <div class="card-body">
                <span class={`chip chip-${s.tone}`}>{s.chip}</span>
                <h3>{a.data.title}</h3>
                <p>{a.data.description}</p>
                <p class="card-meta">
                  {a.data.pricesCheckedOn
                    ? <span>Prices checked {fmt(a.data.pricesCheckedOn)}</span>
                    : <span>{fmt(a.data.pubDate)}</span>}
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <section class="bleed method" id="method">
    <h2>How I work</h2>
    <ol class="steps">
      <li>
        <span class="step-n">1</span>
        <h3>I go to the source</h3>
        <p>
          I use the pricing page, terms or help centre, and link to the pages I used so you can
          check them yourself.
        </p>
      </li>
      <li>
        <span class="step-n">2</span>
        <h3>I put a date on it</h3>
        <p>
          Prices move. Each guide tells you when I last checked them.
        </p>
      </li>
      <li>
        <span class="step-n">3</span>
        <h3>I look for the catch</h3>
        <p>
          There is nearly always one. Credits that quietly expire, a plan that will not give
          you a WAV, a renewal price nothing like the first year. That is usually the bit that
          decides it.
        </p>
      </li>
    </ol>
    <p class="method-foot">
      I don't run listening tests. When sound quality matters, I link to people who have.
      Where a link is an affiliate or referral link, the page it sits on says so plainly. That
      is as far as it goes: I only recommend things I would use myself, and no amount of money
      buys a mention here.
    </p>
  </section>

  <Newsletter variant="inline" />
</BaseLayout>
