---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_DESCRIPTION, withBase } from '../consts';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: new URL(withBase('/'), Astro.site).href,
};
---
<BaseLayout title={SITE_NAME} schema={schema}>
  <div class="page-head">
    <h1>Prices with a date on them</h1>
    <p class="lede">
      What AI and software audio tools cost, and what their licences let you do with the output.
    </p>
    <p>
      Search for any AI music tool and most of what comes back was written by the company
      selling it, or by someone who last checked a price a year ago. We read the pricing pages
      and the terms ourselves, write down the date we read them, and link to them so you can
      check our work.
    </p>
    <p>
      We do not run listening tests. We have no test rig, so we do not pretend to. Where
      something is judged on how it sounds, the judgement belongs to a named source and is
      linked, and every article ends with the sources it was built from.
    </p>
  </div>

  <div class="section-head"><h2>Latest</h2></div>
  <ul class="list">
    {articles.map((a) => (
      <li>
        <h2><a href={withBase(`/articles/${a.id}/`)}>{a.data.title}</a></h2>
        <p>{a.data.description}</p>
        <p class="meta">
          <span>{fmt(a.data.pubDate)}</span>
          {a.data.pricesCheckedOn && <span>Prices checked {fmt(a.data.pricesCheckedOn)}</span>}
        </p>
      </li>
    ))}
  </ul>
</BaseLayout>
