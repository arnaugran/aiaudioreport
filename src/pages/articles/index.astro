---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../consts';

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

// Subjects are derived from tags in priority order, so every article lands in
// exactly one group and the page cannot drift as articles are added. Raw tags
// would not work: "pricing" is on 11 of 15 pieces, so it groups nothing.
const GROUPS = [
  { id: 'samples',   name: 'Samples and libraries', tags: ['samples'],
    blurb: 'What a sound costs, by subscription, by pack and free.' },
  { id: 'mastering', name: 'Mastering',             tags: ['mastering'],
    blurb: 'Rent a service or buy a plugin, and what "unlimited" leaves out.' },
  { id: 'stems',     name: 'Stem separation',       tags: ['stem separation'],
    blurb: 'Splitting a mix apart, and which paid tiers can actually do it.' },
  { id: 'tools',     name: 'Software and tools',    tags: ['DAWs', 'plugins', 'local tools'],
    blurb: 'What is genuinely free, and what runs without uploading your audio.' },
  { id: 'rights',    name: 'Rights and releasing',  tags: ['licensing', 'AI music', 'distribution'],
    blurb: 'Who owns the output, and which platforms will carry it.' },
];

const used = new Set<string>();
const grouped = GROUPS.map((g) => {
  const items = all.filter(
    (a) => !used.has(a.id) && g.tags.some((t) => a.data.tags.includes(t))
  );
  items.forEach((a) => used.add(a.id));
  return { ...g, items };
}).filter((g) => g.items.length > 0);

// Anything a future tag combination misses still has to appear somewhere.
const ungrouped = all.filter((a) => !used.has(a.id));

const checked = all.map((a) => a.data.pricesCheckedOn).filter(Boolean) as Date[];
const lastChecked = checked.length
  ? new Date(Math.max(...checked.map((d) => d.valueOf())))
  : null;

// Data for the rotating pick. Rendered server side as the newest article so
// the section is never empty without JavaScript, then swapped client side to
// the entry for today's date.
const picks = all.map((a) => ({
  t: a.data.title,
  d: a.data.description,
  u: withBase(`/articles/${a.id}/`),
  s: a.id,
}));
---
<BaseLayout
  title="Articles"
  description="Every AI Audio Report article, grouped by subject. Each one carries the date its prices and licence terms were last checked against the source."
>
  <div class="page-head">
    <h1>Articles</h1>
    <p class="lede">
      {all.length} pieces, grouped by what you are trying to decide. Every figure carries the
      date it was read off the vendor's own page.
    </p>
  </div>

  <div class="section-head">
    <h2>Today's pick</h2>
    <span class="meta">Rotates daily</span>
  </div>
  <div class="pick" id="pick">
    <h3><a id="pick-link" href={picks[0].u}>{picks[0].t}</a></h3>
    <p id="pick-desc">{picks[0].d}</p>
  </div>

  {grouped.map((g) => (
    <>
      <div class="section-head">
        <h2>{g.name}</h2>
        <span class="meta" data-count-for={g.id}>{g.items.length} {g.items.length === 1 ? 'piece' : 'pieces'}</span>
      </div>
      <p class="meta group-blurb">{g.blurb}</p>
      <ul class="list" data-group={g.id}>
        {g.items.map((a) => (
          <li data-slug={a.id}>
            <h3><a href={withBase(`/articles/${a.id}/`)}>{a.data.title}</a></h3>
            <p>{a.data.description}</p>
            <p class="meta">
              <span>{fmt(a.data.pubDate)}</span>
              {a.data.pricesCheckedOn && <span>Prices checked {fmt(a.data.pricesCheckedOn)}</span>}
            </p>
          </li>
        ))}
      </ul>
    </>
  ))}

  {ungrouped.length > 0 && (
    <>
      <div class="section-head"><h2>Also published</h2></div>
      <ul class="list">
        {ungrouped.map((a) => (
          <li>
            <h3><a href={withBase(`/articles/${a.id}/`)}>{a.data.title}</a></h3>
            <p>{a.data.description}</p>
            <p class="meta"><span>{fmt(a.data.pubDate)}</span></p>
          </li>
        ))}
      </ul>
    </>
  )}

  {lastChecked && (
    <p class="meta" style="margin-top:2.5rem">
      The most recent price check on this site was {fmt(lastChecked)}. Anything older than
      about 30 days is due for re-reading, and we would rather you knew that than assumed
      otherwise.
    </p>
  )}

  <script is:inline define:vars={{ picks }}>
    // The pick changes with the date rather than at random, so the same day
    // always shows the same article and a reload does not reshuffle it. The
    // server-rendered fallback above means this section still works with
    // JavaScript disabled; it simply does not rotate.
    (function () {
      try {
        if (!picks || picks.length < 2) return;
        var now = new Date();
        var days = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 86400000);
        var p = picks[((days % picks.length) + picks.length) % picks.length];
        var link = document.getElementById('pick-link');
        var desc = document.getElementById('pick-desc');
        if (!link || !desc) return;
        link.textContent = p.t;
        link.setAttribute('href', p.u);
        desc.textContent = p.d;

        // The featured article also appears in its subject group. Sitting
        // directly beneath itself it reads as a duplication bug, so drop the
        // row and correct that group's count. Without JavaScript neither the
        // rotation nor this removal happens, which is why the count is
        // rendered from the data rather than hard-coded.
        var row = document.querySelector('li[data-slug="' + p.s + '"]');
        if (!row) return;
        var list = row.closest('ul.list');
        row.remove();
        if (!list) return;
        var label = document.querySelector('[data-count-for="' + list.dataset.group + '"]');
        if (!label) return;
        var left = list.querySelectorAll('li').length;
        label.textContent = left + (left === 1 ? ' piece' : ' pieces');
      } catch (e) {}
    })();
  </script>
</BaseLayout>
