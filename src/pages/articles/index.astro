---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../consts';
import Newsletter from '../../components/Newsletter.astro';

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

// Subjects are derived from tags in priority order, so every article lands in
// exactly one group and the page cannot drift as articles are added. Raw tags
// would not work: "pricing" is on 11 of 15 pieces, so it groups nothing.
const GROUPS = [
  { id: 'samples',   name: 'Samples and libraries', tags: ['samples'],
    blurb: 'What a sound costs, by subscription, by pack and free.' },
  { id: 'mastering', name: 'Mastering',             tags: ['mastering'],
    blurb: 'Rent a service or buy a plugin, and what "unlimited" leaves out.' },
  { id: 'stems',     name: 'Stem separation',       tags: ['stem separation'],
    blurb: 'Splitting a mix apart, and which paid tiers can actually do it.' },
  { id: 'tools',     name: 'Software and tools',    tags: ['DAWs', 'plugins', 'local tools'],
    blurb: 'What is genuinely free, and what runs without uploading your audio.' },
  { id: 'rights',    name: 'Rights and releasing',  tags: ['licensing', 'AI music', 'distribution'],
    blurb: 'Who owns the output, and which platforms will carry it.' },
];

const used = new Set<string>();
const grouped = GROUPS.map((g) => {
  const items = all.filter(
    (a) => !used.has(a.id) && g.tags.some((t) => a.data.tags.includes(t))
  );
  items.forEach((a) => used.add(a.id));
  return { ...g, items };
}).filter((g) => g.items.length > 0);

// Anything a future tag combination misses still has to appear somewhere.
const ungrouped = all.filter((a) => !used.has(a.id));

const checked = all.map((a) => a.data.pricesCheckedOn).filter(Boolean) as Date[];
const lastChecked = checked.length
  ? new Date(Math.max(...checked.map((d) => d.valueOf())))
  : null;

// Data for the rotating pick. Rendered server side as the newest article so
// the section is never empty without JavaScript, then swapped client side to
// the entry for today's date.
const picks = all.map((a) => ({
  t: a.data.title,
  d: a.data.description,
  u: withBase(`/articles/${a.id}/`),
  s: a.id,
}));
---
<BaseLayout
  title="Articles"
  description="Every AI Audio Report article, grouped by subject. Each one carries the date its prices and licence terms were last checked against the source."
>
  <div class="page-head">
    <h1>Articles</h1>
  </div>

  {/* On this page the search happens in the page. Someone who came here to
      browse should not have a panel thrown over the list they are reading;
      the list itself becomes the results. The header overlay is for every
      other page, where there is nothing to replace. */}
  <form class="pgsearch" role="search" id="pgsearch" onsubmit="return false">
    <label class="pgsearch-label" for="pgsearch-input">Search articles</label>
    <svg class="pgsearch-icon" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.7"/>
      <line x1="10.6" y1="10.6" x2="14.4" y2="14.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
    <input id="pgsearch-input" type="search" autocomplete="off" spellcheck="false"
           placeholder="Search prices, tools, licence terms&hellip;" aria-controls="pgsearch-out" />
    <button type="button" class="pgsearch-x" id="pgsearch-x" hidden>
      <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
        <line x1="2" y1="2" x2="12" y2="12" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
        <line x1="12" y1="2" x2="2" y2="12" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
      </svg>
      Clear
    </button>
  </form>

  <div id="pgsearch-out" hidden>
    <div class="section-head">
      <h2 id="pgsearch-h">Results</h2>
      <span class="meta" id="pgsearch-count"></span>
    </div>
    <ul class="list" id="pgsearch-list"></ul>
    <p class="meta" id="pgsearch-none" hidden>
      Nothing matched. Try a product name on its own, or a shorter word.
    </p>
  </div>

  <div id="browse">
  <div class="section-head section-head--pick">
    <h2>Today's pick</h2>
    <span class="meta">Rotates daily</span>
  </div>
  <div class="pick" id="pick">
    <h3><a id="pick-link" href={picks[0].u}>{picks[0].t}</a></h3>
    <p id="pick-desc">{picks[0].d}</p>
  </div>

  {grouped.map((g) => (
    <>
      <div class="section-head">
        <h2>{g.name}</h2>
        <span class="meta" data-count-for={g.id}>{g.items.length} {g.items.length === 1 ? 'piece' : 'pieces'}</span>
      </div>
      <p class="meta group-blurb">{g.blurb}</p>
      <ul class="list" data-group={g.id}>
        {g.items.map((a) => (
          <li data-slug={a.id}>
            <h3><a href={withBase(`/articles/${a.id}/`)}>{a.data.title}</a></h3>
            <p>{a.data.description}</p>
            <p class="meta">
              <span>{fmt(a.data.pubDate)}</span>
              {a.data.pricesCheckedOn && <span>Prices checked {fmt(a.data.pricesCheckedOn)}</span>}
            </p>
          </li>
        ))}
      </ul>
    </>
  ))}

  {ungrouped.length > 0 && (
    <>
      <div class="section-head"><h2>Also published</h2></div>
      <ul class="list">
        {ungrouped.map((a) => (
          <li>
            <h3><a href={withBase(`/articles/${a.id}/`)}>{a.data.title}</a></h3>
            <p>{a.data.description}</p>
            <p class="meta"><span>{fmt(a.data.pubDate)}</span></p>
          </li>
        ))}
      </ul>
    </>
  )}

  </div>

  <Newsletter variant="inline" />

  {lastChecked && (
    <p class="meta" style="margin-top:2.5rem">
      The most recent price check on this site was {fmt(lastChecked)}. Anything older than
      about 30 days is due for re-reading, and I would rather you knew that than assumed
      otherwise.
    </p>
  )}

  <script is:inline define:vars={{ picks }}>
    // The pick changes with the date rather than at random, so the same day
    // always shows the same article and a reload does not reshuffle it. The
    // server-rendered fallback above means this section still works with
    // JavaScript disabled; it simply does not rotate.
    (function () {
      try {
        if (!picks || picks.length < 2) return;
        var now = new Date();
        var days = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 86400000);
        var p = picks[((days % picks.length) + picks.length) % picks.length];
        var link = document.getElementById('pick-link');
        var desc = document.getElementById('pick-desc');
        if (!link || !desc) return;
        link.textContent = p.t;
        link.setAttribute('href', p.u);
        desc.textContent = p.d;

        // The featured article also appears in its subject group. Sitting
        // directly beneath itself it reads as a duplication bug, so drop the
        // row and correct that group's count. Without JavaScript neither the
        // rotation nor this removal happens, which is why the count is
        // rendered from the data rather than hard-coded.
        var row = document.querySelector('li[data-slug="' + p.s + '"]');
        if (!row) return;
        var list = row.closest('ul.list');
        row.remove();
        if (!list) return;
        var label = document.querySelector('[data-count-for="' + list.dataset.group + '"]');
        if (!label) return;
        var left = list.querySelectorAll('li').length;
        label.textContent = left + (left === 1 ? ' piece' : ' pieces');
      } catch (e) {}
    })();
  </script>

  <script is:inline>
    // In-page search. The browse view and the results view are the same piece
    // of page: typing swaps one for the other, so nothing is covered up and
    // clearing the field puts the list back exactly as it was.
    (function () {
      var F = window.FRSearch;
      var input = document.getElementById('pgsearch-input');
      if (!F || !input) return;

      var browse = document.getElementById('browse');
      var out = document.getElementById('pgsearch-out');
      var list = document.getElementById('pgsearch-list');
      var count = document.getElementById('pgsearch-count');
      var none = document.getElementById('pgsearch-none');
      var clear = document.getElementById('pgsearch-x');
      var heading = document.getElementById('pgsearch-h');

      function show(found, qs, q) {
        list.innerHTML = found.map(function (h) {
          return '<li><h3><a href="' + F.esc(F.href(h.s)) + '">' + F.mark(h.t, qs) + '</a></h3>' +
                 '<p>' + F.mark(h.d, qs) + '</p>' +
                 (h.p ? '<p class="meta"><span>Prices checked ' + F.esc(h.p) + '</span></p>' : '') +
                 '</li>';
        }).join('');
        none.hidden = found.length > 0;
        heading.textContent = 'Results for \u201C' + q + '\u201D';
        count.textContent = found.length
          ? found.length + (found.length === 1 ? ' piece' : ' pieces')
          : '';
      }

      function run() {
        var q = input.value.trim();
        clear.hidden = !q;
        if (!q) {
          out.hidden = true;
          browse.hidden = false;
          list.innerHTML = '';
          return;
        }
        browse.hidden = true;
        out.hidden = false;
        if (!F.loaded()) count.textContent = 'Searching\u2026';
        F.search(q).then(function (found) {
          if (input.value.trim() !== q) return;
          show(found, F.tokens(q), q);
        });
      }

      var t;
      input.addEventListener('input', function () { clearTimeout(t); t = setTimeout(run, 80); });
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && input.value) {
          e.preventDefault();
          e.stopPropagation();   // not the header overlay's Escape to take
          input.value = '';
          run();
        }
      });
      clear.addEventListener('click', function () { input.value = ''; run(); input.focus(); });

      // Fetch the index as soon as the field is touched, so the first keystroke
      // is not the thing waiting on the network.
      input.addEventListener('focus', function () { F.load(); }, { once: true });

      // A query carried in from elsewhere, for example ?q=mastering.
      var q0 = new URLSearchParams(location.search).get('q');
      if (q0) { input.value = q0; run(); }
    })();
  </script>
</BaseLayout>
