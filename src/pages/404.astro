---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../consts';
---
<BaseLayout title="Page not found" noindex={true} description="That page does not exist on AI Audio Report.">
  <h1 class="page-title">That page isn’t here</h1>
  <p class="lede">Either the link is wrong or we moved something and failed to redirect it.</p>
  <p>
    Try <a href={withBase('/articles/')}>the article index</a>, or
    <a href={withBase('/contact/')}>tell us what you were looking for</a>. If a link of ours
    is broken, we would rather know.
  </p>
</BaseLayout>
