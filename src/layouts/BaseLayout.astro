---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';
import { SITE_NAME, SITE_DESCRIPTION, withBase } from '../consts';

interface Props {
  title: string;
  description?: string;
  schema?: object | null;
  noindex?: boolean;
}
const { title, description = SITE_DESCRIPTION, schema = null, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Google truncates the title around 60 characters. The brand suffix costs 18 of
// them, which on a long article title buys recognition we do not have yet at the
// price of the keywords we are trying to rank for. So the suffix is only added
// when it still fits.
const withBrand = `${title} | ${SITE_NAME}`;
const fullTitle = title === SITE_NAME ? title : (withBrand.length <= 60 ? withBrand : title);
const ogImage = new URL(withBase('/og-default.png'), Astro.site).href;
---
<!doctype html>
<html lang="en" data-cookies-url={withBase('/cookies/')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      GitHub Pages cannot set response headers, so the policy that can be
      expressed in a meta tag is set here. frame-ancestors, HSTS,
      X-Content-Type-Options and Permissions-Policy are header-only and are
      applied at the Cloudflare edge instead.

      script-src keeps 'unsafe-inline' because the consent gate and the
      analytics loader are inline by design: they must run before anything
      else and must not be a separate request. The site takes no user input,
      has no auth and embeds no third-party content, so the residual risk is
      small, but it is a real trade-off rather than an oversight.
    */}
    <meta http-equiv="Content-Security-Policy" content={[
      "default-src 'self'",
      "base-uri 'self'",
      "object-src 'none'",
      "form-action 'none'",
      "frame-src 'none'",
      "script-src 'self' 'unsafe-inline' https://*.googletagmanager.com",
      "style-src 'self' 'unsafe-inline'",
      "img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com",
      "font-src 'self'",
      // Analytics hits go to a REGIONAL host, region1.google-analytics.com for
      // European visitors, so the wildcard is required and not laziness. An
      // exact www host silently dropped every EU pageview. The apex
      // analytics.google.com is listed separately because *.analytics.google.com
      // does not match a bare domain with no subdomain label.
      "connect-src 'self' https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com",
      "manifest-src 'self'",
      "upgrade-insecure-requests",
    ].join('; ')} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" content="#15171a" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={withBase('/rss.xml')} />
    <meta name="generator" content={Astro.generator} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <Analytics />
  </body>
</html>
