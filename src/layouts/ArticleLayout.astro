---
import BaseLayout from './BaseLayout.astro';
import MethodologyNote from '../components/MethodologyNote.astro';
import NotLegalAdvice from '../components/NotLegalAdvice.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import Toc from '../components/Toc.astro';
import Related from '../components/Related.astro';
import AdSlot from '../components/AdSlot.astro';
import Banner from '../components/Banner.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE_NAME, AFFILIATES_ENABLED, AD_SLOTS, withBase } from '../consts';

const { entry, headings = [], all = [] } = Astro.props;
const d = entry.data;
const fmt = (x: Date) =>
  x.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const iso = (x: Date) => x.toISOString().slice(0, 10);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL(withBase('/'), Astro.site).href;
const index = new URL(withBase('/articles/'), Astro.site).href;

const graph: any[] = [
  {
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    datePublished: iso(d.pubDate),
    dateModified: iso(d.updatedDate ?? d.pubDate),
    author: { '@type': 'Organization', name: d.byline },
    ...(d.reviewedBy && { reviewedBy: { '@type': 'Person', name: d.reviewedBy } }),
    publisher: { '@type': 'Organization', name: SITE_NAME, url: home },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    isAccessibleForFree: true,
    keywords: d.tags.join(', '),
    citation: d.sources.map((s: any) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: home },
      { '@type': 'ListItem', position: 2, name: 'Articles', item: index },
      { '@type': 'ListItem', position: 3, name: d.title, item: canonical },
    ],
  },
];
if (d.faq?.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f: any) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
const schema = { '@context': 'https://schema.org', '@graph': graph };
---
<BaseLayout title={d.title} description={d.description} schema={schema} ogPath={`/og/${entry.id}.png`}>
  <article>
    <div class="page-head">
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      <p class="meta">
        <span>{d.byline}</span>
        <span>{fmt(d.pubDate)}</span>
        {d.updatedDate && <span>Updated {fmt(d.updatedDate)}</span>}
        {d.reviewedBy && <span>Reviewed by {d.reviewedBy}</span>}
      </p>
      <p class="provenance">
        {AFFILIATES_ENABLED
          ? 'Some links on this page are affiliate links and may earn us a commission. '
          : 'No affiliate links on this page, and nothing here earns us anything. '}
        {d.pricesCheckedOn
          ? `Prices were checked on ${fmt(d.pricesCheckedOn)} against the sources listed at the end. `
          : 'Every figure comes from the sources listed at the end. '}
        <a href="#how-we-know">How we know this</a>.
      </p>
    </div>

    <Banner seed={entry.id} />

    {d.notLegalAdvice && <NotLegalAdvice />}
    <Toc headings={headings} />

    <slot />

    <AdSlot slot={AD_SLOTS.articleEnd} />

    {d.faq?.length > 0 && (
      <section>
        <h2 id="faq">Questions people actually ask</h2>
        {d.faq.map((f: any) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))}
      </section>
    )}

    <Newsletter />

    <section class="endmatter" id="how-we-know">
      <MethodologyNote basis={d.basis} pricesCheckedOn={d.pricesCheckedOn} />
      <AffiliateDisclosure />
    </section>

    <h2 id="sources">Sources</h2>
    <p class="meta" style="margin-bottom:1rem">Each of these was opened and read on the date shown.</p>
    <ol class="sources">
      {d.sources.map((s: any) => (
        <li><a href={s.url} rel="noopener">{s.title}</a>, read {fmt(s.checked)}</li>
      ))}
    </ol>
    <p class="meta" style="margin-top:1.75rem">
      Found something out of date or wrong? <a href={withBase('/contact/')}>Tell us</a>. We
      will fix it and say that we did.
    </p>

    <Related current={entry} all={all} />

    <AdSlot slot={AD_SLOTS.articleFooter} />
  </article>
</BaseLayout>
