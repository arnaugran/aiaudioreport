---
import { ADS_ENABLED, ADSENSE_CLIENT } from '../consts';
interface Props { slot: string }
const { slot } = Astro.props;

// Renders absolutely nothing unless advertising is switched on AND this slot
// has a real ad unit ID from AdSense. No reserved space, no script, no layout
// shift, no markup at all while ads are off.
//
// The unit is not filled here. Ads.astro pushes to it once the visitor has
// consented and the AdSense script has actually loaded, so a reader who
// declines never causes a request to Google.
const show = ADS_ENABLED && Boolean(ADSENSE_CLIENT) && Boolean(slot);
---
{show && (
  <aside class="adslot" aria-label="Advertisement">
    <span class="adslot-label">Advertisement</span>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
  </aside>
)}
