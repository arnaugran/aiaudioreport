---
import { withBase } from '../consts';
const path = Astro.url.pathname;
const links = [
  { href: '/articles/', label: 'Articles' },
  { href: '/about/', label: 'About' },
  { href: '/editorial-policy/', label: 'How we work' },
  { href: '/contact/', label: 'Contact' },
];
---
<header class="masthead">
  <div class="container">
    <a class="brand" href={withBase('/')}>AI Audio <span>Report</span></a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={withBase(l.href)} aria-current={path === withBase(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
