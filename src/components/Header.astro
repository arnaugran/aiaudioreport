---
import { withBase } from '../consts';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/articles/', label: 'Articles' },
  { href: '/contact/', label: 'Contact' },
];
---
<header class="masthead">
  <div class="container">
    <a class="brand" href={withBase('/')}><Logo /><span class="wordmark">AI Audio <span>Report</span></span></a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={withBase(l.href)} aria-current={path === withBase(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      {/* Opens the search overlay in place. It used to navigate to the
          articles index, which cost you the page you were reading. */}
      <button class="nav-search" type="button" data-search-open
              aria-label="Search articles" title="Search articles">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.7"/>
          <line x1="10.6" y1="10.6" x2="14.4" y2="14.4" stroke="currentColor"
                stroke-width="1.7" stroke-linecap="round"/>
        </svg>
        <span>Search</span>
      </button>
    </nav>
  </div>
</header>
