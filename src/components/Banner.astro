---
import { withBase } from '../consts';
interface Props { seed: string }
const { seed } = Astro.props;

// Article header photograph.
//
// Source and licence: Unsplash, read 8 November 2026. Commercial use with no
// permission and no attribution required. Full provenance, including the two
// things that licence forbids and which we do not do, is in
// public/img/CREDITS.txt.
//
// Self-hosted rather than hot-linked, for two reasons: the site's CSP sets
// img-src to 'self', and loading images from a third party would disclose
// every reader's IP address to that third party, which the privacy policy
// says we do not do.
//
// The photo is chosen by hashing the slug, so an article keeps the same
// header for good and adding new articles never reshuffles the existing
// ones. With eight photographs across fifteen articles some repeat, which is
// why the set is picked to be tonally consistent rather than attention
// grabbing.
// Filenames are approximate labels for what the photograph roughly shows,
// not descriptions. They are never shown to a reader: the images are
// decorative and carry an empty alt, so nothing is claimed by them.
const PHOTOS = [
  'mixing-desk',
  'headphones-keys',
  'studio-console',
  'daw-screens',
  'desk-monitors',
  'production-setup',
  'mic-headphones',
  'keys-dark',
];

function hash(s: string): number {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}
const photo = PHOTOS[hash(seed) % PHOTOS.length];
const p = (w: number, ext: string) => withBase(`/img/${photo}-${w}.${ext}`);
---
<figure class="banner">
  <picture>
    <source
      type="image/avif"
      srcset={`${p(800, 'avif')} 800w, ${p(1600, 'avif')} 1600w`}
      sizes="(max-width: 46rem) 100vw, 40rem"
    />
    <source
      type="image/webp"
      srcset={`${p(800, 'webp')} 800w, ${p(1600, 'webp')} 1600w`}
      sizes="(max-width: 46rem) 100vw, 40rem"
    />
    {/* Decorative: the photograph illustrates nothing the text does not say,
        so it carries an empty alt rather than a description a screen reader
        would have to sit through. width and height are set to reserve the
        space and stop the headline jumping as it loads. */}
    <img
      src={p(1600, 'webp')}
      alt=""
      width="1600"
      height="533"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
</figure>
