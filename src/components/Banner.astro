---
import { withBase } from '../consts';
import { headerPhoto } from '../lib/photos.mjs';
interface Props { seed: string; tags?: string[] }
const { seed, tags = [] } = Astro.props;

// Article header photograph.
//
// Source and licence: Unsplash, read 8 November 2026. Commercial use, no
// permission needed, attribution not required. Full provenance for every file
// is in public/img/CREDITS.txt.
//
// Self-hosted rather than hot-linked, for two concrete reasons: the CSP sets
// img-src to 'self' so hot-linked images would be blocked, and loading them
// from a third party would disclose every reader's IP to that third party,
// which the privacy policy says we do not do.
//
// Photographs are chosen by SUBJECT, not at random. An article about mastering
// gets a console, one about voice rights gets a microphone. The pairs exist so
// that two articles in the same group do not open with the same picture, and
// the choice inside a pair is a hash of the slug, so an article keeps its
// photograph permanently and new articles never reshuffle the old ones.
//
// Filenames are rough labels, never shown to a reader. The images are
// decorative and carry an empty alt, so nothing is claimed by them.
const photo = headerPhoto(seed, tags);
const p = (w: number, ext: string) => withBase(`/img/${photo}-${w}.${ext}`);
---
<figure class="banner">
  <picture>
    <source
      type="image/avif"
      srcset={`${p(800, 'avif')} 800w, ${p(1600, 'avif')} 1600w`}
      sizes="(max-width: 46rem) 100vw, 40rem"
    />
    <source
      type="image/webp"
      srcset={`${p(800, 'webp')} 800w, ${p(1600, 'webp')} 1600w`}
      sizes="(max-width: 46rem) 100vw, 40rem"
    />
    {/* Decorative: the photograph illustrates nothing the text does not say,
        so it carries an empty alt rather than a description a screen reader
        would have to sit through. width and height are set to reserve the
        space and stop the headline jumping as it loads. */}
    <img
      src={p(1600, 'webp')}
      alt=""
      width="1600"
      height="533"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
</figure>
