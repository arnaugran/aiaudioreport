---
import { SITE_NAME, withBase } from '../consts';
const year = new Date().getFullYear();
const links = [
  { href: '/affiliate-disclosure/', label: 'Affiliate disclosure' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/cookies/', label: 'Cookies' },
  { href: '/contact/', label: 'Contact' },
];
---
<footer class="foot">
  <div class="container">
    <nav aria-label="Footer">
      {links.map((l) => <a href={withBase(l.href)}>{l.label}</a>)}
      <a href={withBase('/rss.xml')}>RSS</a>
    </nav>
    <p>
      I date the prices and licence terms so you can see when I last checked them. Follow the
      source links before you buy; the details can change.
    </p>
    <p>© {year} {SITE_NAME}. <button type="button" id="cookie-reopen">Cookie settings</button></p>
  </div>
</footer>
