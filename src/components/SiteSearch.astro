---
// Site-wide search overlay. Opens in place from the header on any page, so
// searching never costs you the page you were reading.
//
// The scoring and the index live in SearchCore, shared with the in-page search
// on the articles index.
---
<div class="srch" id="srch" hidden>
  <div class="srch-back" id="srch-back"></div>
  <div class="srch-panel" role="dialog" aria-modal="true" aria-labelledby="srch-label">
    <label class="srch-label" id="srch-label" for="srch-input">Search articles</label>
    <div class="srch-bar">
      <svg class="srch-icon" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.7"/>
        <line x1="10.6" y1="10.6" x2="14.4" y2="14.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>
      <input id="srch-input" type="search" autocomplete="off" spellcheck="false"
             placeholder="Search prices, tools, licence terms&hellip;" aria-controls="srch-results" />
      <button type="button" class="srch-x" id="srch-x">
        <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
          <line x1="2" y1="2" x2="12" y2="12" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
          <line x1="12" y1="2" x2="2" y2="12" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
        </svg>
        Close
      </button>
    </div>
    <div class="srch-body">
      <p class="srch-hint" id="srch-hint">
        Try a product name, a price, or a licence term. Everything is searched, including
        the body of each article.
      </p>
      <ul class="srch-results" id="srch-results" role="listbox" aria-label="Search results"></ul>
    </div>
    <div class="srch-foot" id="srch-foot" hidden><span id="srch-count"></span></div>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.getElementById('srch');
    if (!root || !window.FRSearch) return;
    var F = window.FRSearch;
    var input = document.getElementById('srch-input');
    var list = document.getElementById('srch-results');
    var hint = document.getElementById('srch-hint');
    var foot = document.getElementById('srch-foot');
    var count = document.getElementById('srch-count');
    var back = document.getElementById('srch-back');

    var hits = [], cursor = -1, lastFocus = null;

    function open() {
      if (!root.hidden) return;
      lastFocus = document.activeElement;
      root.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      // Force a layout so the transition has a starting point, then add the
      // class in the same tick. requestAnimationFrame looks tidier but never
      // fires in a background or unpainted tab, which would leave the panel
      // laid out at opacity zero and the page unusable behind it.
      void root.offsetWidth;
      root.classList.add('is-in');
      input.focus();
      input.select();
      F.load();
    }

    function close() {
      if (root.hidden) return;
      root.classList.remove('is-in');
      root.hidden = true;
      document.documentElement.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    function render(qs) {
      list.innerHTML = hits.map(function (h, i) {
        return '<li role="option" aria-selected="' + (i === cursor) + '"' +
               (i === cursor ? ' class="is-on"' : '') + '>' +
               '<a href="' + F.esc(F.href(h.s)) + '">' +
               '<span class="srch-t">' + F.mark(h.t, qs) + '</span>' +
               '<span class="srch-d">' + F.mark(h.d, qs) + '</span>' +
               (h.p ? '<span class="srch-m">Prices checked ' + F.esc(h.p) + '</span>' : '') +
               '</a></li>';
      }).join('');
      var on = list.querySelector('.is-on');
      if (on) on.scrollIntoView({ block: 'nearest' });
    }

    function run() {
      var q = input.value.trim();
      if (!q) {
        hits = []; cursor = -1; list.innerHTML = '';
        hint.hidden = false; foot.hidden = true; count.textContent = '';
        return;
      }
      hint.hidden = true;
      foot.hidden = false;
      if (!F.loaded()) count.textContent = 'Searching…';
      F.search(q).then(function (found) {
        if (input.value.trim() !== q) return;
        hits = found;
        cursor = hits.length ? 0 : -1;
        render(F.tokens(q));
        count.textContent = hits.length
          ? hits.length + (hits.length === 1 ? ' result' : ' results')
          : 'No match for “' + q + '”';
      });
    }

    var t;
    input.addEventListener('input', function () { clearTimeout(t); t = setTimeout(run, 80); });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        if (!hits.length) return;
        e.preventDefault();
        cursor = (cursor + (e.key === 'ArrowDown' ? 1 : -1) + hits.length) % hits.length;
        render(F.tokens(input.value.trim()));
      } else if (e.key === 'Enter') {
        var a = list.querySelector('.is-on a');
        if (a) { e.preventDefault(); window.location.href = a.getAttribute('href'); }
      }
    });

    document.getElementById('srch-x').addEventListener('click', close);
    back.addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !root.hidden) { e.preventDefault(); close(); }
      // Cmd+K and Ctrl+K are the shortcuts people already have in their hands.
      if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) { e.preventDefault(); open(); }
    });

    // Every trigger on the page, wherever it lives. The articles index has its
    // own search field and does not use one of these.
    Array.prototype.forEach.call(document.querySelectorAll('[data-search-open]'), function (el) {
      el.addEventListener('click', function (e) { e.preventDefault(); open(); });
    });
  })();
</script>
