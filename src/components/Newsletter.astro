---
import { NEWSLETTER_ENABLED, NEWSLETTER_ACTION, withBase } from '../consts';
interface Props { variant?: 'full' | 'inline' }
const { variant = 'full' } = Astro.props;

// Renders nothing unless the flag is on AND a real endpoint exists. Without
// that second condition an enabled form would post back to the current page,
// which looks like it worked and collects nothing.
const show = NEWSLETTER_ENABLED && Boolean(NEWSLETTER_ACTION);
---
{show && (
  <aside class={`signup${variant === 'inline' ? ' signup--inline' : ''}`} aria-labelledby="signup-h">
    <div class="signup-top">
      <span class="signup-mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <rect x="2.6" y="5" width="18.8" height="14" rx="2.4" stroke="currentColor" stroke-width="1.7"/>
          <path d="M3.4 7.2 12 13.2l8.6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <div class="signup-head">
        <p class="signup-kicker">The price watch</p>
        <h2 id="signup-h" class="signup-h">One email when a price moves</h2>
      </div>
    </div>

    <p class="signup-p">
      Every figure here was read off a vendor's own page on a stated date, and those pages keep
      changing. We re-read them, so you do not have to. New comparisons go out the same way.
    </p>

    <ul class="signup-list">
      <li>Price changes on the tools covered here, with the old number and the new one</li>
      <li>Licence and terms rewrites, which is usually where the catch turns up</li>
    </ul>

    {/* Posts in this tab, which is what Buttondown's own embed code does.
        Opening it in a new tab looked tidier and did not work: the request
        never reached Buttondown, so nothing was ever subscribed. */}
    <form class="signup-form" action={NEWSLETTER_ACTION} method="post">
      <label class="signup-label" for="signup-email">Email address</label>
      <div class="signup-row">
        <input
          id="signup-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
        />
        <button type="submit">Subscribe</button>
      </div>
    </form>

    <p class="signup-small">
      We send a confirmation email first, so nothing arrives unless you say yes. Two emails a
      month at most, every one with a one-click unsubscribe. We never sell or share the list,
      and what happens to your address is set out in the
      <a href={withBase('/privacy/')}>privacy policy</a>.
    </p>
  </aside>
)}
