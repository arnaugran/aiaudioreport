---
interface Props { basis: string; pricesCheckedOn?: Date }
const { basis, pricesCheckedOn } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const text: Record<string, string> = {
  documentation:
    'I based this on the companies’ own terms and documentation. The source links and the dates I checked them are below.',
  'documentation+published-reviews':
    'I used the vendor documentation, published prices and the reviews linked below. I haven’t run listening tests, so any sound-quality claims are attributed to the people who did.',
  analysis:
    'This is my reading of the sources linked below. Where I couldn’t verify a detail, I’ve said so.',
};
---
<aside class="note note--method">
  <strong>Sources and method</strong>
  <p>{text[basis] ?? text.analysis}</p>
  {pricesCheckedOn && (
    <p>Prices last checked {fmt(pricesCheckedOn)}. Check the linked price page before you buy; these can change.</p>
  )}
</aside>
