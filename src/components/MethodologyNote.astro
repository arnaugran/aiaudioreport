---
interface Props { basis: string; pricesCheckedOn?: Date }
const { basis, pricesCheckedOn } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const text: Record<string, string> = {
  documentation:
    'Everything here comes from the companies’ own terms and documentation. We read those pages ourselves and linked them at the bottom.',
  'documentation+published-reviews':
    'This comes from vendor documentation, published pricing pages and third-party reviews, all linked at the bottom. We did not run listening tests. We have no test rig, so we are not going to pretend we did. Where something is judged on sound quality, we say who judged it.',
  analysis:
    'This is our reading of the sources linked at the bottom. It is analysis, not a report of hands-on testing.',
};
---
<aside class="note note--method">
  <strong>How we know this</strong>
  <p>{text[basis] ?? text.analysis}</p>
  {pricesCheckedOn && (
    <p>Every price here was checked on {fmt(pricesCheckedOn)}. Companies change pricing without warning, so check the source links before you buy.</p>
  )}
</aside>
